{
  "dataset": "data/processed/complementary",
  "expansion": "data/processed/structured-train",
  "researchConfig": "configs/full.json",
  "output": "results/l40s",
  "seed": 42,
  "seeds": [
    42,
    43,
    44,
    45,
    46
  ],
  "maxRetrievals": 2,
  "backbones": {
    "base": {
      "model": "answerdotai/ModernBERT-base",
      "revision": "8949b909ec900327062f0ebf497f51aef5e6f0c8"
    },
    "large": {
      "model": "answerdotai/ModernBERT-large",
      "revision": "45bb4654a4d5aaff24dd11d4781fa46d39bf8c13"
    }
  },
  "encoder": {
    "toolSchema": "configs/abcd-fields.json",
    "positionalTools": true,
    "retrievalCost": 1.0,
    "retrievals": 2,
    "maxLength": 1024,
    "queryTokens": 128,
    "overlap": 64,
    "chunks": 8,
    "encoderBatch": 8,
    "retrievalDocuments": 5,
    "gradientCheckpointing": true,
    "precision": "bf16",
    "packedQueries": true
  },
  "training": {
    "epochs": 3,
    "encoderLr": 2e-05,
    "headLr": 0.0003,
    "weightDecay": 0.01,
    "accumulation": 4,
    "progressEvery": 100,
    "checkpointEvery": 1000
  },
  "demand": {
    "epochs": 20,
    "selectorEpochs": 20,
    "folds": 3,
    "lr": 0.001,
    "batchSize": 64,
    "dailyWeight": 0.3,
    "minHistory": 28
  },
  "policy": {
    "iterations": 2,
    "epochs": 2,
    "noise": 0.1
  }
}
